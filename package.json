{
  "name": "voice-bubble",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --config wrangler.local.jsonc --local",
    "start": "npm run dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:check": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run deploy:check && tsx --test --test-concurrency=1 tests/*.test.ts",
    "dev:test": "tsx tests/worker/browser-server.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "6.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.2.0",
    "miniflare": "5.20261012.0-beta",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.151.0"
  }
}

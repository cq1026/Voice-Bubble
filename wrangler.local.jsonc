{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-bubble-local",
  "main": "src/server/app.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.wav"], "fallthrough": true },
  ],
  "vars": {
    "AUTH_MODE": "local",
    "PUBLIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_PAID_GENERATION": "false",
    "BUBBLE_PALETTE": "lavender",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voice-bubble-local",
      "database_id": "local-voice-bubble",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "voice-bubble-audio-local" },
  ],
}

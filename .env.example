# Local development: no API key needed for existing test audio.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000
AUTH_MODE=local
DATA_DIR=.data
BUBBLE_PALETTE=lavender
MEDIA_URL_TTL_SECONDS=600
ENABLE_TEST_HOST=false

# Keep false until you explicitly choose to enable paid generation.
ENABLE_PAID_GENERATION=false
ELEVENLABS_API_KEY=
# Copy a real ID from your ElevenLabs account or list_voice_options. No fabricated default.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Public deployment requires AUTH_MODE=oauth, HOST=0.0.0.0 and an HTTPS PUBLIC_BASE_URL.
# Issuer, JWKS and subject are metadata, not passwords. Copy exact values from your IdP.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_OWNER_SUB=

# For compose.yaml: a DNS name you control, without https:// or paths.
VOICE_BUBBLE_DOMAIN=
